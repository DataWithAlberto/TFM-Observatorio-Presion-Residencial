# PostgreSQL (desarrollo local; cambie la contraseña fuera de este entorno)
POSTGRES_DB=tfm_presion_residencial
POSTGRES_USER=postgres
POSTGRES_PASSWORD=tfm_pass
POSTGRES_PORT=5433

# API y aplicación web publicadas en el equipo anfitrión
API_PORT=8000
WEB_PORT=3000
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Use 1 sólo para forzar una recarga de los datos procesados al arrancar
FORCE_BOOTSTRAP=0
